// Prisma schema for Kurzly's API.
//
// Prisma 7 makes `prisma-client` the default generator and requires an
// explicit `output` path (RESEARCH Pattern 4). This path is fixed now so
// Phase 2's better-auth Prisma adapter imports the exact same generated
// client instance (see .claude/CLAUDE.md's Prisma 7 breaking-change note).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// NOTE: Prisma 7.8.0 no longer accepts `url` inside the `datasource` block
// in schema.prisma (P1012 validation error) — the connection URL moved to
// `prisma.config.ts` (see that file, and https://pris.ly/d/config-datasource).
// This supersedes the plan/RESEARCH.md guidance, which predates this
// point-release breaking change; keeping this note so Phase 2 doesn't
// reintroduce `url` here.

datasource db {
  provider = "postgresql"
}

/// Walking-skeleton model used as the vehicle for the D-08 persistence-canary
/// proof (data survives a docker-compose down/up cycle without -v) and as a
/// base placeholder ahead of Phase 2's better-auth schema additions.

model PersistenceCanary {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id            String             @id
  name          String
  email         String
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   DomainMembership[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Domain model (extended in Phase 3 with hostname, type, status, DNS
/// verification fields — D-01/D-02/D-03/D-04, RESEARCH Pattern 1/4).
model Domain {
  id                 String             @id @default(cuid())
  hostname           String             @unique
  type               DomainType
  status             DomainStatus       @default(pending)
  verificationTarget String
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  lastCheckError     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  memberships        DomainMembership[]

  @@index([status])
}

/// Domain type (D-02): subdomain (verified via CNAME) or apex domain
/// (verified via A/ALIAS record). Native Postgres enum, mirrors the
/// existing `Role` enum's precedent below.
enum DomainType {
  subdomain
  apex
}

/// Domain lifecycle status (D-03): pending (never verified or awaiting
/// re-check) -> active (last check succeeded) or failed (last check
/// failed). Indexed via `@@index([status])` for the ask endpoint's fast
/// active-domain lookup (RESEARCH Pitfall 3).
enum DomainStatus {
  pending
  active
  failed
}

/// Domain-scoped role hierarchy (D-02, CR-01 fix). A native Postgres enum
/// (not a plain TEXT column) so an invalid/typo'd role value can never be
/// persisted in the first place — defense-in-depth alongside the
/// `requireDomainAccess` code-level guard in
/// apps/api/src/lib/authorization.ts, which independently denies access if
/// it ever encounters a role outside this set. Keep in sync with
/// `ROLE_RANK`/`ROLE_HIERARCHY` (authorization.ts / packages/shared).
enum Role {
  member
  admin
  owner
}

/// Domain-scoped role membership (D-02) — the single row
/// `requireDomainAccess`/`scopedDomainIds` (apps/api/src/lib/authorization.ts,
/// built in 02-03) query against. Composite PK enforces exactly one role
/// per user per domain; cascade deletes so removing a User or Domain
/// cleans up its memberships automatically.
model DomainMembership {
  userId   String
  domainId String
  role     Role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([userId, domainId])
}
