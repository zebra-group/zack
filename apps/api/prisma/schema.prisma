// Prisma schema for Kurzly's API.
//
// Prisma 7 makes `prisma-client` the default generator and requires an
// explicit `output` path (RESEARCH Pattern 4). This path is fixed now so
// Phase 2's better-auth Prisma adapter imports the exact same generated
// client instance (see .claude/CLAUDE.md's Prisma 7 breaking-change note).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// NOTE: Prisma 7.8.0 no longer accepts `url` inside the `datasource` block
// in schema.prisma (P1012 validation error) — the connection URL moved to
// `prisma.config.ts` (see that file, and https://pris.ly/d/config-datasource).
// This supersedes the plan/RESEARCH.md guidance, which predates this
// point-release breaking change; keeping this note so Phase 2 doesn't
// reintroduce `url` here.

datasource db {
  provider = "postgresql"
}

/// Walking-skeleton model used as the vehicle for the D-08 persistence-canary
/// proof (data survives a docker-compose down/up cycle without -v) and as a
/// base placeholder ahead of Phase 2's better-auth schema additions.

model PersistenceCanary {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
}

model User {
  id            String             @id
  name          String
  email         String
  emailVerified Boolean            @default(false)
  image         String?
  /// Global account role (Phase 9, D-09-01) — what this user IS on this
  /// installation, distinct from the per-domain `Role` enum below (what a
  /// user may do WITHIN one domain, via `DomainMembership`). Admin =
  /// everything on this installation; Member = only assigned domains
  /// (Links/QR/Analytics). Additive/defaulted so every pre-existing row
  /// backfills to the least-privileged "member" (T-09-MIGR-BACKFILL) — no
  /// existing user is silently elevated by this migration.
  accountRole   AccountRole        @default(member)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   DomainMembership[]
  links         Link[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Domain model (extended in Phase 3 with hostname, type, status, DNS
/// verification fields — D-01/D-02/D-03/D-04, RESEARCH Pattern 1/4).
model Domain {
  id                 String             @id @default(cuid())
  hostname           String             @unique
  type               DomainType
  status             DomainStatus       @default(pending)
  verificationTarget String
  verifiedAt         DateTime?
  lastCheckedAt      DateTime?
  lastCheckError     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  memberships        DomainMembership[]
  links              Link[]

  @@index([status])
}

/// Domain type (D-02): subdomain (verified via CNAME) or apex domain
/// (verified via A/ALIAS record). Native Postgres enum, mirrors the
/// existing `Role` enum's precedent below.
enum DomainType {
  subdomain
  apex
}

/// Domain lifecycle status (D-03): pending (never verified or awaiting
/// re-check) -> active (last check succeeded) or failed (last check
/// failed). Indexed via `@@index([status])` for the ask endpoint's fast
/// active-domain lookup (RESEARCH Pitfall 3).
enum DomainStatus {
  pending
  active
  failed
}

/// Global account role (Phase 9, D-09-01) — a native Postgres enum (not a
/// plain TEXT column) so an invalid/typo'd value can never be persisted,
/// mirroring the `Role` enum's own defense-in-depth precedent immediately
/// below. Distinct from `Role`: this is the installation-wide role
/// (`User.accountRole`), never the per-domain one (`DomainMembership.role`).
/// The one shared authorization primitive that reads this is
/// `isAccountAdmin` (apps/api/src/lib/accountRole.ts) — both the
/// authorization-helper admin bypass (09-02) and the team routes (09-03/
/// 09-04) import it rather than re-deriving the check ad hoc.
enum AccountRole {
  admin
  member
}

/// Domain-scoped role hierarchy (D-02, CR-01 fix). A native Postgres enum
/// (not a plain TEXT column) so an invalid/typo'd role value can never be
/// persisted in the first place — defense-in-depth alongside the
/// `requireDomainAccess` code-level guard in
/// apps/api/src/lib/authorization.ts, which independently denies access if
/// it ever encounters a role outside this set. Keep in sync with
/// `ROLE_RANK`/`ROLE_HIERARCHY` (authorization.ts / packages/shared).
enum Role {
  member
  admin
  owner
}

/// Domain-scoped role membership (D-02) — the single row
/// `requireDomainAccess`/`scopedDomainIds` (apps/api/src/lib/authorization.ts,
/// built in 02-03) query against. Composite PK enforces exactly one role
/// per user per domain; cascade deletes so removing a User or Domain
/// cleans up its memberships automatically.
model DomainMembership {
  userId   String
  domainId String
  role     Role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@id([userId, domainId])
}

/// Link model (LINK-01/02/03, D-01/D-02/D-03) — the single tenant-scoped
/// short-link resource this phase introduces. Every row is written through
/// exactly one path: `apps/api/src/lib/links.ts`'s `createLink` (D-01
/// single-write-path core) — no other code in the codebase may call
/// `prisma.link.create`. `@@unique([domainId, slug])` is the authoritative
/// per-domain uniqueness guarantee (the app-level `resolveSlug` pre-check in
/// lib/links.ts is a friendly-error fast path, not the real guarantee — see
/// its P2002 catch). Deleting a Domain cascade-deletes its Links (a domain's
/// short links have no meaning without the domain); deleting a User nulls
/// `createdBy` (SetNull) so their created links survive their departure —
/// matches DomainMembership's cascade but intentionally differs on Link
/// since a link's history/target should outlive its creator's account.
model Link {
  id        String   @id @default(cuid())
  domainId  String
  slug      String
  targetUrl String
  title     String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Password gate (Phase 5, D-02) — bcrypt hash only, never plaintext.
  /// `null` means "not password-protected". Set/cleared/re-hashed
  /// exclusively inside `apps/api/src/lib/links.ts`'s single write path
  /// (createLink/updateLink) — never exposed on any DTO (toLinkDto derives
  /// only `passwordProtected: boolean` from this).
  passwordHash String?
  /// Expiry (Phase 5, D-03) — day-granularity, persisted as the UTC
  /// end-of-day instant of the chosen date. `null` means "never expires".
  expiresAt    DateTime?
  /// Query-parameter forwarding (Phase 5, D-12) — when true, incoming
  /// query params are merged onto targetUrl at redirect time (target URL
  /// wins on conflict, D-13). Defaults off so existing links are unaffected.
  forwardQuery Boolean   @default(false)
  /// Internal click tracking toggle (Phase 6, TRACK-01/D-15) — when true,
  /// the redirect engine records a ClickEvent for this link. Defaults on
  /// so existing links keep tracking unless the owner opts out.
  trackingEnabled Boolean @default(true)
  /// Pruning-resistant all-time click counter (Phase 6, D-13) — incremented
  /// only by the redirect click hook (06-04), never by this plan. Survives
  /// ClickEvent retention pruning (06-04) since it is not derived from the
  /// event rows at read time.
  lifetimeClicks  Int     @default(0)

  /// UTM builder trio (Phase 8, D-08-01/D-08-02) — stored as their own
  /// columns, never concatenated into `targetUrl`: applied at redirect time
  /// (redirectEngine.ts) so the owner-typed target stays clean and the
  /// link list/detail screens can render a "UTM set" badge/chip. When set,
  /// these override same-named query keys already present on the target
  /// (D-08-02) — the link owner's intent wins over whatever the stored
  /// target happens to carry. `null` means "no UTM parameters set".
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// Custom OG trio (Phase 8, D-08-03/D-08-04) — owner-authored text served
  /// to bots for EVERY link state (protected/expired/active alike, per
  /// D-06's generic-branded-200 contract, which this preserves). `null`
  /// means "keep the generic brand fallback" for that field.
  /// `ogImageUrl` is validated for SHAPE ONLY (absolute http/https) and the
  /// server NEVER fetches it (D-08-04) — the whole anti-SSRF point of this
  /// phase; only the visitor's own browser (form preview) or a crawler
  /// (og:image tag) ever requests it.
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?

  domain      Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  creator     User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  clickEvents ClickEvent[]
  qrCodes     QrCode[]

  @@unique([domainId, slug])
  @@index([domainId])
}

/// Scan source (Phase 6, D-14) — distinguishes a normal short-link redirect
/// click from a QR-code scan. `qr` is reserved now (Phase 7 wires QR code
/// scans); only `link` is ever written by Phase 6's redirect click hook.
enum ScanSource {
  link
  qr
}

/// Internal click-tracking event (Phase 6, TRACK-01/02, D-13/D-14) — the
/// per-visit row the redirect click hook (06-04) writes and analytics reads
/// (06-05) aggregate over. Privacy-first (RESEARCH): no raw IP is ever
/// persisted here — only a derived, non-reversible `visitorHash` and a
/// coarse `country`. `@@index` is always explicit (never rely on the FK
/// alone), mirroring `Link`'s own `@@index([domainId])` convention.
model ClickEvent {
  id           String     @id @default(cuid())
  linkId       String
  createdAt    DateTime   @default(now())
  country      String?
  referrerHost String?
  visitorHash  String
  source       ScanSource @default(link)

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([createdAt])
  @@index([source])
}

/// Daily rotating salt (Phase 6, D-14) — input to `visitorHash`'s
/// non-reversible per-day visitor derivation (IP + User-Agent + this salt),
/// so the same visitor cannot be correlated across days. `date` (UTC
/// YYYY-MM-DD) is the natural primary key — one row per day.
model DailySalt {
  date      String   @id
  value     String
  createdAt DateTime @default(now())
}

/// QR code variant (Phase 7, QR-02/QR-03) — static QR codes are permanently
/// bound to one Link (their `linkId` IS their target); dynamic QR codes own
/// their own `/q/:code` short code and can be re-pointed to a different
/// target Link over time (07-06's remap flow) while the printed code stays
/// valid. Native Postgres enum, mirrors `ScanSource`'s lowercase-value
/// precedent.
enum QrCodeVariant {
  static
  dynamic
}

/// QR code model (QR-02/03/04/07) — the single QR-studio resource this phase
/// introduces. Every row is written through exactly one path:
/// `apps/api/src/lib/qrCodes.ts` — no other code in the codebase may call
/// `prisma.qrCode.create`/`update` (mirrors Link's single-write-path
/// discipline). `linkId` is the bound Link for a static code, or the
/// *current* target Link for a dynamic code — a single Link relation
/// serves both cases since a static QR's bound link IS its target.
/// `code` is the dynamic `/q/:code` short code: a plain `@unique` flat
/// global namespace (NOT domain-scoped like `Link.slug`, which is why this
/// differs from Link's composite `@@unique([domainId, slug])`) and is only
/// ever set for `variant: dynamic` rows. Logo bytes are stored directly on
/// the row (RESEARCH Open-Question 3 resolution) rather than a new
/// object-storage dependency — bounded by the 2 MB upload cap enforced in
/// 07-05. Deleting the bound/target Link cascade-deletes the QrCode (a QR
/// code has no meaning without a link to encode).
model QrCode {
  id             String        @id @default(cuid())
  variant        QrCodeVariant
  linkId         String
  /// Dynamic-only `/q/:code` short code. `null` for static QR codes.
  code           String?       @unique
  name           String
  color          String
  roundedModules Boolean       @default(false)
  logoEnabled    Boolean       @default(false)
  /// Logo image bytes — always PNG after `normalizeLogo` (lib/qr.ts)
  /// rasterizes any SVG upload once at write time. INDEPENDENT of
  /// `logoEnabled`, which only gates whether these bytes are composited at
  /// render time: `updateQrCode` (lib/qrCodes.ts) writes the two as
  /// separate optional fields, and `logoEnabled: true` with no stored bytes
  /// is an explicitly supported state (see `QrCodeDTO` in
  /// packages/shared/src/index.ts).
  logoData       Bytes?
  logoMimeType   String?
  /// Pruning-resistant all-time scan counter (mirrors `Link.lifetimeClicks`,
  /// Phase 6, D-13 precedent) — incremented ONLY by the `/q` scan hook
  /// (07-06), never a live COUNT over ClickEvent rows.
  lifetimeScans  Int           @default(0)
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  link         Link              @relation(fields: [linkId], references: [id], onDelete: Cascade)
  remapHistory QrRemapHistory[]

  @@index([linkId])
  @@index([code])
}

/// Dynamic QR remap audit trail (QR-04) — one row per re-point of a dynamic
/// QR code's target Link, mirroring `ClickEvent`'s per-event-row shape.
/// Written exclusively by the remap path in `apps/api/src/lib/qrCodes.ts`
/// alongside the `QrCode.linkId` update (07-06). `@@index` is always
/// explicit (never rely on the FK alone), matching `ClickEvent`'s
/// `@@index([linkId])` / `@@index([createdAt])` convention.
model QrRemapHistory {
  id         String   @id @default(cuid())
  qrCodeId   String
  fromLinkId String
  toLinkId   String
  createdAt  DateTime @default(now())

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([createdAt])
}
