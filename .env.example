# Zack — environment configuration (D-07)
#
# Copy this file to `.env` and fill in real values. Nothing is hardcoded
# in the Docker image (INFRA-02) — every variable below is required (or
# has a documented default) by the fail-fast validator in
# apps/api/src/env.ts, which aborts the process with exit 1 and a clear
# message if a required variable is missing or invalid.
#
# This file must document every key the schema reads — a drift test
# (apps/api/test/env-example-drift.test.ts) fails the build if a schema
# variable is added here without also being added to the schema, or
# vice versa. Never commit real secrets here — placeholders only.

# App
# development | test | production (default: development)
NODE_ENV=production
# HTTP port the Fastify server listens on (default: 3000)
PORT=3000
# Public origin the app is served from (used for magic-link/redirect URLs)
BASE_URL=https://zack.example.com
# Session/token signing secret — min 32 chars. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=changeme-generate-a-real-32-plus-char-secret

# Database
# postgres:18-alpine service in docker-compose.yml — never a real
# production credential in this example file.
#
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB initialize the `db` service
# itself (docker-compose.yml); DATABASE_URL is what the `app` service uses
# to connect. Postgres never parses DATABASE_URL — keep these three values
# in sync with the credentials embedded in DATABASE_URL below.
POSTGRES_USER=zack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=zack
DATABASE_URL=postgresql://zack:changeme@db:5432/zack

# SMTP (magic-link email delivery — consumed from Phase 2 onward, but
# validated at boot now so a bad config fails fast rather than crashing
# cryptically the first time a magic-link email is sent)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true | false (default: false)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Bare email address (schema uses z.email() — no "Name <email>" header
# format here; nodemailer's `from` display name, if desired, is a
# separate concern for the mail-sending code in Phase 2)
SMTP_FROM=no-reply@example.com

# Auth (Phase 2 — better-auth magic-link)
# First-admin bootstrap (D-01): no public signup, invite-only allowlist
# starts empty. This is the ONE seeded owner/admin email that can always
# log in, so a fresh deployment is never un-loginable. Operator chooses
# this value before first boot.
INITIAL_ADMIN_EMAIL=admin@example.com

# Reverse proxy (Phase 2 — WR-02)
# true | false (default: false). Set to true ONLY when this app sits
# behind a reverse proxy that terminates TLS and sets X-Forwarded-For
# (docker-compose.yml documents that setup as the operator's own
# responsibility). Enables Fastify's `trustProxy`, so `request.ip` (and
# therefore the magic-link/global rate limits) reflects the real client
# IP instead of the proxy's own address. Leave false for a direct
# internet-facing deployment with no proxy in front — enabling it in that
# case would let any client spoof its rate-limit identity via a forged
# X-Forwarded-For header.
TRUST_PROXY=false

# Domain verification (Phase 3, D-02 — CNAME/A-record ownership proof)
# Fixed CNAME target subdomain owners point their DNS at (default:
# shortener.zack.local — change to your instance's real hostname).
CNAME_TARGET=shortener.zack.local
# Fixed A-record IPv4 apex-domain owners point their DNS at (default:
# 0.0.0.0 — change to your instance's real public IP).
A_RECORD_IP=0.0.0.0

# Branding (Phase 5, D-10) — consumed only by the server-rendered public
# HTML layer (password/expiry/404 pages + bot-OG tags). Not retrofitted
# into the dashboard SPA (Phase 2-4 scope).
# Brand name shown on public pages (default: Zack).
BRAND_NAME=Zack
# Accent color override for public pages' inline <style> block (default: #d7ff01).
BRAND_ACCENT=#d7ff01

# Password hashing (Phase 5, D-02)
# bcryptjs cost factor for link-password hashing (default: 11). Keep
# conservative (10-11) so the redirect hot path doesn't block under
# concurrent password-verify load.
PASSWORD_HASH_COST=11

# Internal tracking / analytics (Phase 6)
# Optional filesystem path to an operator-supplied GeoIP .mmdb database
# (D-03). When unset, lib/geoip.ts falls back to the build-baked
# /prod/api/geo/dbip-country-lite.mmdb bundled in the image.
GEOIP_DB_PATH=
# Optional positive integer -- number of days raw ClickEvent rows are kept
# before being pruned (D-12). When unset, click events are never pruned.
CLICK_RETENTION_DAYS=

# OIDC / SSO (Phase 10, D-10-01/02/06/07) - optional, self-hosted operator
# configures SSO entirely via these three ENV vars (per D-10-02, the admin
# UI is a status + setup-guidance surface, never a live credential-entry
# form). Leaving ALL THREE empty disables SSO (magic-link keeps working
# unchanged); a PARTIAL set (some but not all three) fails boot with a
# clear error - never a half-enabled login path.
#
# After setting these, register this callback URL with your IdP (replace
# with your real BASE_URL): {BASE_URL}/api/auth/oauth2/callback/oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
